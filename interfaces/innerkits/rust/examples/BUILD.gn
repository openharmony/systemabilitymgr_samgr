import("//build/ohos.gni")
import("../../../../config.gni")

ohos_rust_executable("samgr_rust_basic") {
  sources = [ "basic.rs" ]
  rustflags = [ "--cfg=multi_instance" ]
  deps = [ "../../rust:samgr_rust" ]
  external_deps = [
    "access_token:libnativetoken",
    "access_token:libtoken_setproc",
    "hilog:hilog_rust",
    "ipc:ipc_rust",
  ]
  subsystem_name = "systemabilitymgr"
  part_name = "samgr"
}
